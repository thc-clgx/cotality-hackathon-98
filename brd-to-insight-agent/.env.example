# Copy this file to .env and fill in the values for your setup.
# .env is gitignored. Never commit it, and never paste a real key into chat or a ticket.
#
# The app needs ONE of the two AI providers below. Choose A or B, not both.
# Resolution order is: environment variables first, then this file. Within each,
# the company gateway wins if it is fully configured.


# ─────────────────────────────────────────────────────────────────────────────
# A. Company LiteLLM gateway  (preferred inside Cotality)
# ─────────────────────────────────────────────────────────────────────────────
# Both BASE_URL and API_KEY must be set, or the gateway is ignored and the app
# falls back to option B. The URL must start with https:// or startup fails.
# Do not include a trailing /v1 - the SDK appends its own path.

LITELLM_BASE_URL=https://your-gateway-host
LITELLM_API_KEY=your-gateway-key

# Model used when the gateway is active. Optional.
# If unset, the app uses its built-in default (gemini-3.5-flash-lite).
LLM_MODEL=gemini-3.1-flash-lite


# ─────────────────────────────────────────────────────────────────────────────
# B. Personal Google AI Studio key  (used only if the gateway above is not set)
# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.

# GEMINI_API_KEY=your-key-here

# Model used with a personal key. Optional; same built-in default applies.
# There is NO automatic fallback to another model: if the configured model is
# unavailable the request fails and says so, rather than silently switching.
# GEMINI_MODEL=gemini-3.1-flash-lite


# ─────────────────────────────────────────────────────────────────────────────
# C. BRD to BigQuery mode  (only needed for the pipeline path, not Excel upload)
# ─────────────────────────────────────────────────────────────────────────────
# Leave this whole section unset to run the app in Excel-upload mode only.
# Authentication uses Google ADC - there is no key to put here. Run:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <your-project>

# BRD_BQ_PROJECT=your-gcp-project-id
# BRD_BQ_DATASET=your_dataset

# How the framework is launched: "cli" runs it as a subprocess.
# BRD_AGENT_MODE=cli
# BRD_AGENT_DIR=/absolute/path/to/brd-to-bigquery-agent
# BRD_AGENT_CMD=/absolute/path/to/python /absolute/path/to/framework_launcher.py -m src.orchestrator.managed_runner --brd {brd} --source-root {source_dir}

# Seconds before a framework run is terminated. Default 900.
# BRD_AGENT_TIMEOUT=900

# Log level requested from the framework. Default INFO.
# BRD_AGENT_LOG_LEVEL=INFO


# ─────────────────────────────────────────────────────────────────────────────
# D. Optional limits  (sensible defaults are built in; override only if needed)
# ─────────────────────────────────────────────────────────────────────────────
# Maximum rows read from one BigQuery table. Default 200000.
# BRD_BQ_ROW_LIMIT=200000

# Upload and in-memory budgets, in megabytes.
# CHART_MAX_UPLOAD_MB=250
# CHART_MAX_FRAME_MB=256
# CHART_MAX_RESULTS_MB=128
